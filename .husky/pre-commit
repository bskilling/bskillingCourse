#!/usr/bin/env bash

echo "🔍 Checking code formatting with Prettier..."
if ! npm run check-format; then
  echo ""
  echo "❌ Oops! Your code formatting is messy."
  echo "💡 Run this to fix it:"
  echo "   👉 npm run format"
  echo ""
  exit 1
fi

echo "🔍 Checking code quality with ESLint..."
if ! npm run lint; then
  echo ""
  echo "❌ ESLint is not happy with your code."
  echo "💡 Run this to fix lint issues:"
  echo "   👉 npm run lint:fix"
  echo ""
  exit 1
fi

echo "🔍 Checking if build succeeds..."
if ! npm run build; then
  echo ""
  echo "❌ Build failed! The app said 'Nope 👎'."
  echo "💡 Fix the errors shown above and try again."
  echo ""
  exit 1
fi

echo ""
echo "🎉 All checks passed!"
echo "🚀 Your code is clean, powerful, and commit-worthy."
echo ""